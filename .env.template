# Copy to .env and fill in real values. Never commit .env.

# Neon Postgres connection string (Connect -> psycopg).
# Must include ?sslmode=require or the connection will fail.
DATABASE_URL=

# Groq API key for answer generation: https://console.groq.com/keys
GROQ_API_KEY=

# Optional, defaults shown.
# EMBED_MODEL decides the vector(N) column width - changing it means
# recreating the table and re-running the ingest script.
EMBED_MODEL=BAAI/bge-m3
GROQ_MODEL=openai/gpt-oss-120b
LOG_LEVEL=INFO
